<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F4F8"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Título -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Rating"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#0D47A1"
            android:layout_marginBottom="12dp" />

        <!-- Descripción -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este programa te permite probar diferentes estilos de Rating. Puedes ver ratings básicos, grandes, pequeños, de solo lectura y personalizados con colores únicos. Desliza sobre las estrellas para indicar tu rating"
            android:textSize="16sp"
            android:textColor="#37474F"
            android:gravity="center"
            android:layout_marginBottom="24dp" />

        <!-- Demo 1: Rating Colores Personalizados -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="#FFF3E0">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rating Colores Personalizados"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:layout_marginBottom="12dp" />

                <com.icc.practica7.ui.AdvancedRatingBar
                    android:id="@+id/ratingCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    style="@style/Widget.App.AdvancedRatingBar.Custom"
                    app:rating="4.5" />

                <TextView
                    android:id="@+id/tvRatingCustom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="#BF360C" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Demo 2: Rating Básico -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="#E8F5E9">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rating Básico"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#1B5E20"
                    android:layout_marginBottom="12dp" />

                <com.icc.practica7.ui.AdvancedRatingBar
                    android:id="@+id/ratingBasic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    app:rating="3.5" />

                <TextView
                    android:id="@+id/tvRatingBasic"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="#2E7D32" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Demo 3: Rating Grande -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="#E3F2FD">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rating Grande"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#0D47A1"
                    android:layout_marginBottom="12dp" />

                <com.icc.practica7.ui.AdvancedRatingBar
                    android:id="@+id/ratingLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    style="@style/Widget.App.AdvancedRatingBar.Large"
                    app:rating="2.5" />

                <TextView
                    android:id="@+id/tvRatingLarge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="#1565C0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Demo 4: Rating Pequeño -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="#FFFDE7">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rating Pequeño"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#F57F17"
                    android:layout_marginBottom="12dp" />

                <com.icc.practica7.ui.AdvancedRatingBar
                    android:id="@+id/ratingSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    style="@style/Widget.App.AdvancedRatingBar.Small"
                    app:rating="4.0" />

                <TextView
                    android:id="@+id/tvRatingSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:textSize="14sp"
                    android:textColor="#FF6F00" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Demo 5: Rating Solo Lectura -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            app:cardElevation="6dp"
            app:cardCornerRadius="16dp"
            android:backgroundTint="#ECEFF1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rating Solo Lectura"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#546E7A"
                    android:layout_marginBottom="12dp" />

                <com.icc.practica7.ui.AdvancedRatingBar
                    android:id="@+id/ratingReadOnly"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    style="@style/Widget.App.AdvancedRatingBar.ReadOnly"
                    app:rating="5.0" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="8dp"
                    android:text="(No editable)"
                    android:textSize="12sp"
                    android:textStyle="italic"
                    android:textColor="#78909C" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>



    </LinearLayout>
</ScrollView>
