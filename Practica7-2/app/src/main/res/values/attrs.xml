<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ===== ADVANCED RATING BAR ===== -->

    <!-- Hook del tema para AdvancedRatingBar -->
    <attr name="advancedRatingBarStyle" format="reference" />

    <!-- Atributos para AdvancedRatingBar -->
    <declare-styleable name="AdvancedRatingBar">
        <attr name="numStars" format="integer" />
        <attr name="rating" format="float" />
        <attr name="starSize" format="dimension" />
        <attr name="starPadding" format="dimension" />
        <attr name="filledStarColor" format="color" />
        <attr name="emptyStarColor" format="color" />
        <attr name="allowHalfStars" format="boolean" />
        <attr name="isEditable" format="boolean" />
        <attr name="animationDuration" format="integer" />
        <attr name="enableHapticFeedback" format="boolean" />
    </declare-styleable>

    <!-- ===== QUANTITY STEPPER ===== -->

    <!-- Hook del tema para QuantityStepper -->
    <attr name="quantityStepperStyle" format="reference" />

    <!-- Atributos para QuantityStepper -->
    <declare-styleable name="QuantityStepper">
        <attr name="qs_min" format="integer" />
        <attr name="qs_max" format="integer" />
        <attr name="qs_step" format="integer" />
        <attr name="qs_initial" format="integer" />
        <attr name="qs_unitPrice" format="float" />
        <attr name="qs_buttonIconMinus" format="reference" />
        <attr name="qs_buttonIconPlus" format="reference" />
        <attr name="qs_tint" format="color" />
        <attr name="qs_cornerRadius" format="dimension" />
        <attr name="qs_buttonSize" format="dimension" />
        <attr name="qs_autoRepeatEnabled" format="boolean" />
        <attr name="qs_vibrateOnLimit" format="boolean" />
    </declare-styleable>
</resources>