<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Tema base de la aplicación -->
    <style name="AppTheme" parent="Theme.Material3.Light.NoActionBar">
        <!-- Hook para AdvancedRatingBar -->
        <item name="advancedRatingBarStyle">@style/Widget.App.AdvancedRatingBar</item>

        <!-- Hook para QuantityStepper -->
        <item name="quantityStepperStyle">@style/Widget.App.QuantityStepper</item>
    </style>

    <!-- Estilo base Widget.App -->
    <style name="Widget.App" parent="android:Widget">
        <!-- Base para todos los widgets personalizados -->
    </style>

    <!-- ===== ADVANCED RATING BAR ===== -->

    <!-- Estilo base de AdvancedRatingBar -->
    <style name="Widget.App.AdvancedRatingBar" parent="Widget.App">
        <item name="numStars">5</item>
        <item name="rating">0</item>
        <item name="starSize">48dp</item>
        <item name="starPadding">8dp</item>
        <item name="filledStarColor">#FFD700</item>
        <item name="emptyStarColor">#E0E0E0</item>
        <item name="allowHalfStars">true</item>
        <item name="isEditable">true</item>
        <item name="animationDuration">200</item>
        <item name="enableHapticFeedback">true</item>
    </style>

    <!-- Variante pequeña -->
    <style name="Widget.App.AdvancedRatingBar.Small" parent="Widget.App.AdvancedRatingBar">
        <item name="starSize">32dp</item>
        <item name="starPadding">4dp</item>
    </style>

    <!-- Variante grande -->
    <style name="Widget.App.AdvancedRatingBar.Large" parent="Widget.App.AdvancedRatingBar">
        <item name="starSize">64dp</item>
        <item name="starPadding">12dp</item>
    </style>

    <!-- Variante solo lectura -->
    <style name="Widget.App.AdvancedRatingBar.ReadOnly" parent="Widget.App.AdvancedRatingBar">
        <item name="isEditable">false</item>
        <item name="enableHapticFeedback">false</item>
    </style>

    <!-- Variante con colores personalizados -->
    <style name="Widget.App.AdvancedRatingBar.Custom" parent="Widget.App.AdvancedRatingBar">
        <item name="filledStarColor">#FF5722</item>
        <item name="emptyStarColor">#FFCCBC</item>
    </style>

    <!-- ===== QUANTITY STEPPER ===== -->

    <!-- Estilo base de QuantityStepper -->
    <style name="Widget.App.QuantityStepper" parent="Widget.App">
        <item name="qs_min">1</item>
        <item name="qs_max">99</item>
        <item name="qs_step">1</item>
        <item name="qs_initial">1</item>
        <item name="qs_unitPrice">0.0</item>
        <item name="qs_buttonIconMinus">@drawable/ic_remove_24</item>
        <item name="qs_buttonIconPlus">@drawable/ic_add_24</item>
        <item name="qs_tint">@color/teal_700</item>
        <item name="qs_cornerRadius">16dp</item>
        <item name="qs_buttonSize">40dp</item>
        <item name="qs_autoRepeatEnabled">true</item>
        <item name="qs_vibrateOnLimit">true</item>
    </style>
</resources>