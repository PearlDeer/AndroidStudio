<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:padding="16dp"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Encabezado sutil -->
    <TextView
        android:id="@+id/txtEncabezado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Mi Lista de Reproducción"
        android:textSize="20sp"
        android:textColor="@color/light_blue"
        android:textStyle="bold"
        android:paddingBottom="16dp"
        android:gravity="center"/>

    <!-- Item de canción -->
    <LinearLayout
        android:orientation="horizontal"
        android:padding="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/item_cancion_background">

        <ImageView
            android:id="@+id/imgCancion"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="Imagen de la canción"
            android:src="@drawable/ic_music_note"
            android:background="?attr/colorPrimaryContainer"
            android:padding="8dp"
            android:tint="@color/light_blue"/>

        <TextView
            android:id="@+id/txtNombre"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:text="Nombre de la canción"
            android:textSize="16sp"
            android:textColor="@color/teal_700"
            android:gravity="center_vertical"/>

        <TextView
            android:id="@+id/txtDuracion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="03:45"
            android:textColor="@color/light_blue"
            android:gravity="center_vertical"
            android:paddingStart="8dp"/>
    </LinearLayout>
</LinearLayout>
